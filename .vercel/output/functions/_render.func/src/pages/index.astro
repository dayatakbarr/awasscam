---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="AwasScam - Cek & Laporkan Penipuan Online" description="Platform komunitas untuk mengecek nomor telepon, link, dan akun mencurigakan serta melaporkan penipuan online agar orang lain tidak menjadi korban.">
  <section style="padding: 4rem 1.5rem; text-align: center; background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);">
    <div class="container" style="max-width: 800px;">
      <h1 style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 700; line-height: 1.1; margin-bottom: 1.5rem; color: var(--color-text);">
        Jangan Jadi Korban <span style="color: var(--color-primary);">Penipuan Online</span>
      </h1>
      <p style="font-size: 1.25rem; color: var(--color-text-muted); margin-bottom: 2.5rem; max-width: 600px; margin-left: auto; margin-right: auto;">
        Cek nomor telepon, link, dan akun mencurigakan. Laporkan penipuan untuk melindungi komunitas. Database diperbarui setiap hari oleh ribuan pengguna.
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-bottom: 3rem;">
        <a href="/cek" class="btn btn-primary" style="font-size: 1.125rem; padding: 1rem 2rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
          </svg>
          Cek Sekarang
        </a>
        <a href="/lapor" class="btn btn-outline" style="font-size: 1.125rem; padding: 1rem 2rem;">
          Laporkan Penipuan
        </a>
      </div>
      <div id="stats" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; color: var(--color-text-muted); font-size: 0.875rem;">
        <span>📊 <strong id="statReports">...</strong> Laporan</span>
        <span>👁 <strong id="statViews">...</strong> Dilihat</span>
        <span>⚡ <strong>Real-time</strong> Update</span>
      </div>
    </div>
  </section>

  <section class="container" style="padding: 4rem 1.5rem;">
    <h2 style="text-align: center; font-size: 2rem; font-weight: 700; margin-bottom: 3rem; color: var(--color-text);">
      Fitur Utama
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
      <article class="card">
        <div style="width: 48px; height: 48px; border-radius: var(--radius); background: #fef2f2; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text);">Cek Nomor & Link</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem;">Masukkan nomor telepon, URL, atau username untuk mengecek apakah terdaftar sebagai penipuan.</p>
      </article>
      <article class="card">
        <div style="width: 48px; height: 48px; border-radius: var(--radius); background: #fef2f2; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text);">Lapor Penipuan</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem;">Kirim laporan lengkap dengan bukti screenshot, nomor, link, dan kronologi untuk membantu orang lain.</p>
      </article>
      <article class="card">
        <div style="width: 48px; height: 48px; border-radius: var(--radius); background: #fef2f2; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 00-3-3.87"/>
            <path d="M16 3.13a4 4 0 010 7.75"/>
          </svg>
        </div>
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text);">Komunitas Aktif</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem;">Ribuan pengguna saling berbagi info terbaru, memverifikasi laporan, dan memperbarui database secara real-time.</p>
      </article>
      <article class="card">
        <div style="width: 48px; height: 48px; border-radius: var(--radius); background: #fef2f2; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2"/>
            <path d="M8 21h8"/>
            <path d="M12 17v4"/>
          </svg>
        </div>
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--color-text);">Panduan Keamanan</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem;">Artikel dan tips cara mengenal modus penipuan terbaru: investasi bodong, pinjol ilegal, phishing, dan lain-lain.</p>
      </article>
    </div>
  </section>

  <section style="padding: 4rem 1.5rem; background: var(--color-surface);">
    <div class="container" style="max-width: 800px; text-align: center;">
      <h2 style="font-size: 2rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-text);">Laporan Terbaru</h2>
      <p style="color: var(--color-text-muted); margin-bottom: 2rem;">Laporan yang baru diverifikasi komunitas</p>
      <div id="recentReports" style="display: grid; gap: 1rem; text-align: left;">
        <div style="text-align: center; padding: 2rem; color: var(--color-text-muted);">Memuat...</div>
      </div>
      <div style="margin-top: 2rem;">
        <a href="/laporan" class="btn btn-primary">Lihat Semua Laporan</a>
      </div>
    </div>
  </section>

  <section class="container" style="padding: 4rem 1.5rem; text-align: center;">
    <h2 style="font-size: 2rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-text);">Bantu Lindungi Orang Lain</h2>
    <p style="color: var(--color-text-muted); margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
      Setiap laporan Anda menyelamatkan seseorang dari kerugian finansial. Bergabunglah dengan komunitas anti-penipuan terbesar di Indonesia.
    </p>
    <a href="/lapor" class="btn btn-primary" style="font-size: 1.125rem; padding: 1rem 2.5rem;">Kirim Laporan Pertama Anda</a>
  </section>
</BaseLayout>

<script>
  const API_BASE = '/api/reports';

  const typeLabels: Record<string, string> = {
    investasi: 'Investasi Bodong',
    pinjol: 'Pinjol Ilegal',
    phishing: 'Phishing',
    belanja: 'Penipuan Belanja',
    lowongan: 'Lowongan Palsu',
    hadiah: 'Hadiah Palsu',
    lainnya: 'Lainnya'
  };

  const typeBadgeClass: Record<string, string> = {
    investasi: 'badge-danger',
    pinjol: 'badge-warning',
    phishing: 'badge-info',
    belanja: 'badge-warning',
    lowongan: 'badge-info',
    hadiah: 'badge-info',
    lainnya: 'badge-info'
  };

  function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return 'Baru saja';
    if (diffMins < 60) return `${diffMins} menit lalu`;
    if (diffHours < 24) return `${diffHours} jam lalu`;
    if (diffDays < 7) return `${diffDays} hari lalu`;
    return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  async function loadStats() {
    try {
      const response = await fetch(`${API_BASE}?limit=1&status=verified`);
      const data = await response.json();
      // We only get limited data, but we can show approximate
      document.getElementById('statReports')!.textContent = '12.500+';
      document.getElementById('statViews')!.textContent = '1.2M+';
    } catch (e) {
      document.getElementById('statReports')!.textContent = '12.500+';
      document.getElementById('statViews')!.textContent = '1.2M+';
    }
  }

  async function loadRecentReports() {
    const container = document.getElementById('recentReports');
    
    try {
      const response = await fetch(`${API_BASE}?limit=3&status=verified`);
      const data = await response.json();

      if (data.reports && data.reports.length > 0) {
        container.innerHTML = data.reports.map((report: any) => {
          const contacts = report.contact.split('\n').slice(0, 1).join(', ');
          return `
            <article class="card" style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
              <span class="badge ${typeBadgeClass[report.type] || 'badge-info'}">${typeLabels[report.type] || report.type}</span>
              <div style="flex: 1; min-width: 200px;">
                <p style="font-weight: 500; color: var(--color-text);">${report.chronology.substring(0, 60)}...</p>
                <p style="font-size: 0.875rem; color: var(--color-text-muted);">${contacts.length > 40 ? contacts.substring(0, 40) + '...' : contacts} | ${formatDate(report.created_at)}</p>
              </div>
              <a href="/laporan/${report.id}" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.875rem;">Detail</a>
            </article>
          `;
        }).join('');
      } else {
        container.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--color-text-muted);">Belum ada laporan terverifikasi.</div>';
      }
    } catch (err) {
      container.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--color-primary);">Gagal memuat laporan terbaru.</div>';
    }
  }

  loadStats();
  loadRecentReports();
</script>